# Private, uncommitted project instructions
/CLAUDE.local.md

# Build artifacts
/bin/
/dist/

# Nix
/result
/result-*
.direnv/

# wip's per-clone directory (H6, C6.8): a decided posture, not an
# accident of .git/info/exclude. On main nothing changes.
.wip/

.DS_Store

# vendor/ is committed whole (flake vendorHash = null). The re-include
# shields it from user-global ignore patterns — a global `*.com` rule
# (Windows executables) would otherwise silently drop vendor/github.com
# from commits.
!vendor/**
